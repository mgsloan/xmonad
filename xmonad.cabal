name:               xmonad
version:            0.18.1.9
synopsis:           A tiling window manager
description:        xmonad is a tiling window manager for X. Windows are arranged
                    automatically to tile the screen without gaps or overlap, maximising
                    screen use. All features of the window manager are accessible from the
                    keyboard: a mouse is strictly optional. xmonad is written and
                    extensible in Haskell. Custom layout algorithms, and other extensions,
                    may be written by the user in config files. Layouts are applied
                    dynamically, and different layouts may be used on each workspace.
                    Xinerama is fully supported, allowing windows to be tiled on several
                    screens.
license:            BSD3
license-file:       LICENSE
author:             Spencer Janssen, Don Stewart, Adam Vogt, David Roundy, Jason Creighton,
                    Brent Yorgey, Peter Jones, Peter Simons, Andrea Rossato, Devin Mullins,
                    Lukas Mai, Alec Berryman, Stefan O'Rear, Daniel Wagner, Peter J. Jones,
                    Daniel Schoepe, Karsten Schoelzel, Neil Mitchell, Joachim Breitner,
                    Peter De Wachter, Eric Mertens, Geoff Reedy, Michiel Derhaeg,
                    Philipp Balzarek, Valery V. Vorotyntsev, Alex Tarkovsky, Fabian Beuke,
                    Felix Hirn, Michael Sloan, Tomas Janousek, Vanessa McHale, Nicolas Pouillard,
                    Aaron Denney, Austin Seipp, Benno Fünfstück, Brandon S Allbery, Chris Mears,
                    Christian Thiemann, Clint Adams, Daniel Neri, David Lazar, Ferenc Wagner,
                    Francesco Ariis, Gábor Lipták, Ivan N. Veselov, Ivan Tarasov, Javran Cheng,
                    Jens Petersen, Joey Hess, Jonne Ransijn, Josh Holland, Khudyakov Alexey,
                    Klaus Weidner, Michael G. Sloan, Mikkel Christiansen, Nicolas Dudebout,
                    Ondřej Súkup, Paul Hebble, Shachaf Ben-Kiki, Siim Põder, Tim McIver,
                    Trevor Elliott, Wouter Swierstra, Conrad Irwin, Tim Thelion, Tony Zorman
maintainer:         xmonad@haskell.org
tested-with:        GHC == 8.6.5 || == 8.8.4 || == 8.10.7 || == 9.0.2 || == 9.2.8 || == 9.4.8 || == 9.6.7 || == 9.8.4 || == 9.10.3 || == 9.12.4 || == 9.14.1
category:           System
homepage:           http://xmonad.org
bug-reports:        https://github.com/xmonad/xmonad/issues
build-type:         Simple
extra-source-files: README.md
                    CHANGES.md
                    CONTRIBUTING.md
                    INSTALL.md
                    MAINTAINERS.md
                    TUTORIAL.md
                    man/xmonad.1.markdown
                    man/xmonad.1
                    man/xmonad.1.html
                    man/xmonad.hs
                    util/hpcReport.sh
cabal-version:      1.12

source-repository head
  type:     git
  location: https://github.com/xmonad/xmonad

flag pedantic
  description: Be pedantic (-Werror and the like)
  default:     False
  manual:      True

library
  exposed-modules: XMonad
                   XMonad.Config
                   XMonad.Core
                   XMonad.Layout
                   XMonad.Main
                   XMonad.ManageHook
                   XMonad.Operations
                   XMonad.StackSet
  other-modules:   Paths_xmonad
  build-depends:   base                  >= 4.12 && < 5
                 , containers
                 , data-default-class
                 , directory
                 , filepath
                 , mtl
                 , process
                 , setlocale
                 , time
                 , transformers          >= 0.3
                 , unix

  -- This package builds against river/Wayland and nothing else.
  --
  -- If something cannot be faithfully ported, it is not exported.  A name that
  -- is present but does nothing is worse than a name that is absent -- absent
  -- fails at the call site, at compile time, with the file and line in the
  -- error.  So this library's API is deliberately a strict subset of upstream
  -- xmonad's, and tests/api/unportable.txt is where each omission has to be
  -- justified, name by name, or tests/api/check-subset.sh fails.
  --
  -- tests/api/upstream/ is upstream xmonad's own interface, recorded from a
  -- real checkout by `tests/api/dump-api.sh tests/api/upstream ../xmonad` and
  -- committed alongside the commit it came from.
  --
  -- Nothing here is named Graphics.X11.  This does not re-export it and does
  -- not imitate it; src/XMonad/Layout.hs imports XMonad.River.Types for
  -- the Rectangle and Event it needs.
  hs-source-dirs:  src
  -- The XMonad.River.* modules are exposed: they are river's own API, named
  -- for what they are, and a river-specific contrib module has every reason
  -- to import them.
  exposed-modules: XMonad.River
                   XMonad.River.Buffer
                   XMonad.River.Client
                   XMonad.River.Connection
                   XMonad.River.Control
                   XMonad.River.Keyboard
                   XMonad.River.Keysym
                   XMonad.River.Keysym.Table
                   XMonad.River.Mailbox
                   XMonad.River.Plan
                   XMonad.River.Runtime
                   XMonad.River.Socket
                   XMonad.River.State
                   XMonad.River.Surface
                   XMonad.River.Trace
                   XMonad.River.Protocol.Core
                   XMonad.River.Protocol.LayerShell
                   XMonad.River.Protocol.LayerShellClient
                   XMonad.River.Protocol.VirtualKeyboard
                   XMonad.River.Protocol.WindowManagement
                   XMonad.River.Protocol.XkbBindings
                   XMonad.River.Types
                   XMonad.River.Wire
                   XMonad.River.Xkb
                   XMonad.River.WM
  build-depends:   bytestring
                 , deepseq
                 , network
                 , store-core
  -- The only C in the package.  Wayland attaches file descriptors as
  -- SCM_RIGHTS to the same sendmsg that carries the request bytes, which
  -- network cannot express and whose CMSG_* macros are not worth
  -- reimplementing against hard-coded struct offsets.  See
  -- XMonad.River.Socket.
  c-sources:       src/cbits/wl-fd.c
  -- libxkbcommon turns the compositor's keymap and a raw evdev keycode into
  -- a keysym and the text it produces.  Needed for prompts: a binding per
  -- keysym can express shortcuts but not typing -- no dead keys, no compose,
  -- no input method.  See XMonad.River.Xkb.
  pkgconfig-depends: xkbcommon

  ghc-options:     -funbox-strict-fields -Wall -Wno-unused-do-bind -Wincomplete-patterns -Wincomplete-uni-patterns
  if impl(ghc > 8.8.4)
    ghc-options:   -Wunused-packages
  default-language: Haskell2010

  -- Keep this in sync with the oldest version in 'tested-with'
  if impl(ghc > 8.6.5)
    ghc-options:   -Wno-unused-imports

  if flag(pedantic)
    ghc-options:   -Werror
    if impl(ghc >= 9.10)
       ghc-options: -Wno-incomplete-record-selectors

executable xmonad
  main-is:       Main.hs
  build-depends: base, xmonad
  ghc-options:   -Wall -Wno-unused-do-bind
  -- The threaded runtime is required.  The event loop waits on two descriptors
  -- at once by forking a watcher for each, sendRestart interrupts a blocking
  -- read with an async exception, and a prompt runs on a thread of its own --
  -- none of which the single-threaded runtime will do while a foreign call is
  -- in progress.
  ghc-options: -threaded -rtsopts
  default-language: Haskell2010

  -- Keep this in sync with the oldest version in 'tested-with'
  if impl(ghc > 8.6.5)
    ghc-options:   -Wno-unused-imports

  if flag(pedantic)
    ghc-options:   -Werror
    if impl(ghc >= 9.10)
       ghc-options: -Wno-incomplete-record-selectors

test-suite properties
  type:           exitcode-stdio-1.0
  main-is:        Properties.hs
  other-modules:  Instances
                  Properties.Delete
                  Properties.Failure
                  Properties.Floating
                  Properties.Focus
                  Properties.GreedyView
                  Properties.Insert
                  Properties.Layout.Full
                  Properties.Layout.Tall
                  Properties.Screen
                  Properties.Shift
                  Properties.Stack
                  Properties.StackSet
                  Properties.Swap
                  Properties.View
                  Properties.Workspace
                  Utils
  hs-source-dirs: tests
  build-depends:  base
                , QuickCheck >= 2
                , quickcheck-classes >= 0.4.3
                , containers
                , xmonad
  -- Covers XMonad.StackSet and the layout arithmetic.  This used to be an
  -- X11-only suite, on the grounds that it reached for Graphics.X11's
  -- Rectangle directly; in fact it wanted Rectangle and Dimension and nothing
  -- else, both of which XMonad.Core exports here, so it is three imports away
  -- from being backend-independent and now runs against this library.
  default-language: Haskell2010

test-suite river-fd
  type:           exitcode-stdio-1.0
  main-is:        river-fd-spec.hs
  hs-source-dirs: tests
  build-depends:  base
                , bytestring
                , network
                , unix
                , xmonad
  default-language: Haskell2010
  ghc-options:    -Wall

  -- Proves an fd can ride on the same sendmsg as the request bytes over a
  -- connected socket.  Without that there is no wl_shm_pool, so no wl_buffer,
  -- so no way for the window manager to draw at all.

test-suite river-wire
  type:           exitcode-stdio-1.0
  main-is:        river-wire-spec.hs
  hs-source-dirs: tests
  build-depends:  base
                , bytestring
                , xmonad
  default-language: Haskell2010
  ghc-options:    -Wall

  -- The wire codec, the only part of the stack testable without a compositor.
  -- Everything above it is unverified until run against a real river; see
  -- README.river.md.

executable river-submap-spec
  main-is:        river-submap-spec.hs
  hs-source-dirs: tests
  build-depends:  base
                , containers
                , unix
                , xmonad
  default-language: Haskell2010
  ghc-options:    -Wall -threaded

  -- A window manager rather than a client: a submap is made of bindings, and
  -- only the window manager has any.  So it links the library and calls
  -- 'launch' with a config of its own, the way somebody's xmonad.hs does.
  -- tests/headless-submap.sh runs it inside a headless river and reads its log.

executable river-prompt-spec
  main-is:        river-prompt-spec.hs
  hs-source-dirs: tests
  build-depends:  base
                , bytestring
                , unix
                , xmonad
  default-language: Haskell2010
  ghc-options:    -Wall -threaded

  -- An executable rather than a test-suite, because it is only meaningful with
  -- a compositor to talk to and `stack test` has none: tests/headless-prompt.sh
  -- starts a headless river and runs this inside it.  -threaded because a
  -- client is a thread and the watchdog is another.

  ghc-options:     -Wno-incomplete-patterns -Wno-incomplete-uni-patterns
  if impl(ghc > 8.8.4)
    ghc-options:   -Wno-unused-packages

  if impl(ghc > 9.8)
    ghc-options:   -Wno-x-partial

  if flag(pedantic)
    ghc-options:   -Werror
    if impl(ghc >= 9.10)
       ghc-options: -Wno-incomplete-record-selectors
